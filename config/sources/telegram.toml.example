account = "personal"
api_id_env_var = "TELEGRAM_API_ID"
api_hash_env_var = "TELEGRAM_API_HASH"
phone_number_env_var = "TELEGRAM_PHONE_NUMBER"
code_env_var = "TELEGRAM_AUTH_CODE"
password_env_var = "TELEGRAM_AUTH_PASSWORD"
tdlib_state_dir = "data/state/telegram/tdlib"
tdlib_library_path = "/run/current-system/sw/lib/libtdjson.so"
artifact_download_policy = "metadata-only"
